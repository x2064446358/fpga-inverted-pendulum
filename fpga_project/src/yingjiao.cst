// =====================================================================
// yingjiao.cst -- LCKFB LogicPi FPGA-G1 (Gowin GW2A-18C / PBGA256)
//
// IO allocation follows 排针映射与IO分配.md (M1):
//   J280 driver-board interface -> IOT / bank 0 pins (3.3 V)
//   IOL / bank 7 -> deliberately left unconstrained for stage-5 expansion
//
// Sources of truth for the expansion pins (three independent, all agreeing):
//   1) schematic net list   EX_IOT13A_G15 ... (ball number is in the net name)
//   2) vendor pinout diagram, page 2 of docs/G1_datasheet.pdf
//   3) Gowin ball database  IDE\data\device\GW2A-18C\PBGA256.json
//
// BANK VOLTAGES (derived from the vendor file docs/立创逻辑派FPGA_G1_IO.cst,
// which marks the pins listed on each bank IO_TYPE=LVCMOS33 BANK_VCCIO=3.3):
//   bank 0 = 3.3 V   (UART F12/F13, 8 digit-tube pins, usb_dp_pull L15)
//   bank 1 = 3.3 V   (seg L14, USB M14/M15)
//   bank 2 = 2.5 V   (HDMI, LVDS25)        <-- never use 3.3 V here
//   bank 3 = 3.3 V   (6 LED pins, 50 MHz clock T7)
//   bank 7 = 3.3 V   (keys D11 / F10)
//   bank 4/5/6 = 1.5 V (DDR3, SSTL15)      <-- not brought out
//
// Ball-name sanity: PBGA256 is 16 x 16, rows A B C D E F G H J K L M N P R T
//   (no I, O, Q, S) and columns 1..16, so B17 / A17 / B18 / B20 do NOT exist
//   (ERROR CT1113).  Verify every ball against the JSON above.
//
// Never reuse -- on-board peripherals:
//   clock T7, keys D11/F10, 6 RGB LEDs (R9 C10 R7 N6 T10 P7),
//   UART F12/F13, digit tube (G13 H16 H12 H13 H14 G12 G11 L14),
//   USB1.1 (M14 M15 L15), HDMI (M10 N11 R12 P13 R11 T12 R13 T14),
//   DDR3 (48 balls), and the 8 balls hard-wired to the on-board ARM:
//   PA0..PA7 = J12 J11 K11 D14 E15 L12 L13 L16.
// =====================================================================

// ===== on-board: clock, reset, key, UART, LEDs =====
IO_LOC  "sys_clk"  T7;                       // 50 MHz board oscillator
IO_PORT "sys_clk"  IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC  "rst_n"    D11;                      // KEY0, active low
IO_PORT "rst_n"    IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC  "key1"     F10;                      // KEY1, active low
IO_PORT "key1"     IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

IO_LOC  "uart_txd" F12;                      // on-board USB-Serial, no wiring
IO_PORT "uart_txd" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "uart_rxd" F13;
IO_PORT "uart_rxd" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// vendor RGB LED map: led[0]=R9 led[1]=C10 led[2]=R7
//                     led[3]=N6 led[4]=T10 led[5]=P7   (common anode -> active low)
IO_LOC  "led"  R9;                           // LED0 red : 1 Hz heartbeat
IO_PORT "led"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "led2" N6;                           // LED1 red : PWM test mode
IO_PORT "led2" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// =====================================================================
// J280 driver board -- all nine pins are BANK 0 = 3.3 V,
// and none of them carries an alternate/config function in the database.
// Header position column = what is printed on the silkscreen.
// =====================================================================

// ---- motor PWM + direction ----
IO_LOC  "PWMA"  G15;                         // EX_IOT13A_G15  排针2 脚07
IO_PORT "PWMA"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "AIN1"  G14;                         // EX_IOT13B_G14  排针2 脚08
IO_PORT "AIN1"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "AIN2"  G16;                         // EX_IOT16A_G16  排针2 脚09
IO_PORT "AIN2"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;

// ---- encoder (ONE channel only in this revision -- see note below) ----
IO_LOC  "EA"    J15;                         // EX_IOT24A_J15  排针1 脚02
IO_PORT "EA"    IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;
IO_LOC  "EB"    K16;                         // EX_IOT24B_K16  排针1 脚01
IO_PORT "EB"    IO_TYPE=LVCMOS33 PULL_MODE=UP BANK_VCCIO=3.3;

// ---- SPI ADC ----
IO_LOC  "ADC_CS"   J16;                      // EX_IOT22A_J16  排针1 脚04
IO_PORT "ADC_CS"   IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "ADC_SCK"  J14;                      // EX_IOT22B_J14  排针1 脚03
IO_PORT "ADC_SCK"  IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "ADC_MOSI" H15;                      // EX_IOT16B_H15  排针2 脚10
IO_PORT "ADC_MOSI" IO_TYPE=LVCMOS33 PULL_MODE=UP DRIVE=8 BANK_VCCIO=3.3;
IO_LOC  "ADC_MISO" F14;                      // EX_IOT9A_F14   排针1 脚05
IO_PORT "ADC_MISO" IO_TYPE=LVCMOS33 PULL_MODE=NONE BANK_VCCIO=3.3;

// =====================================================================
// NOT in this revision
// ---------------------------------------------------------------------
// K1..K4 (optional kit buttons) were proposed on N10 / M11 / P11 / T11.
// Those four are BANK 2 -- the HDMI bank at 2.5 V, so they must be
//   IO_TYPE=LVCMOS25 BANK_VCCIO=2.5, not LVCMOS33.
// The IOL / bank 7 pins are intentionally left unconstrained for stage 5.
// =====================================================================
